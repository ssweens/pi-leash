{
  "name": "@ssweens/pi-leash",
  "version": "1.2.3",
  "license": "MIT",
  "type": "module",
  "private": false,
  "author": "ssweens (forked from @aliou/pi-guardrails)",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "leash",
    "guardrails",
    "security",
    "sudo",
    "permissions"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ssweens/pi-leash"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "TEST_COVERAGE.md",
    "LICENSE"
  ],
  "dependencies": {},

  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.99.1 <0.100.0",
    "@earendil-works/pi-ai": ">=0.99.1 <0.100.0",
    "@earendil-works/pi-coding-agent": ">=0.99.1 <0.100.0",
    "@earendil-works/pi-tui": ">=0.99.1 <0.100.0"
  },
  "devDependencies": {
    "@aliou/biome-plugins": "^0.3.2",
    "@biomejs/biome": "^2.3.13",
    "@earendil-works/pi-agent-core": "0.99.1",
    "@earendil-works/pi-ai": "0.99.1",
    "@earendil-works/pi-coding-agent": "0.99.1",
    "@types/node": "^25.0.10",
    "husky": "^9.1.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "pnpm": {
    "overrides": {
      "@earendil-works/pi-ai": "$@earendil-works/pi-coding-agent",
      "@earendil-works/pi-tui": "$@earendil-works/pi-coding-agent"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check",
    "format": "biome check --write",
    "check:lockfile": "pnpm install --frozen-lockfile --ignore-scripts",
    "prepare": "[ -d .git ] && husky || true",
    "release": "npm publish"
  },
  "packageManager": "pnpm@10.26.1",
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  }
}
